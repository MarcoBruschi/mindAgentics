{
  "appId": "com.mindagentics.app",
  "productName": "mindAgentics",
  "copyright": "Copyright © 2026 mindAgentics Team",
  "directories": {
    "output": "dist-package"
  },
  "files": [
    "packages/main/dist/**/*",
    "packages/preload/dist/**/*",
    "packages/renderer/dist/**/*",
    "packages/core-daemon/dist/**/*",
    "packages/core-daemon/bin/**/*",
    "packages/shared/dist/**/*",
    "package.json",
    "packages/*/package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/node-pty/**/*",
    "**/*.node"
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "mindAgentics"
  }
}
