{
  "name": "mind-agentics",
  "version": "0.26.0",
  "private": true,
  "description": "Spatial AI Development Workspace & Infinite Agent Canvas",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@maestri/shared",
    "build:core": "npm run build --workspace=@maestri/core-daemon",
    "build:preload": "npm run build --workspace=@maestri/preload",
    "build:renderer": "npm run build --workspace=@maestri/renderer",
    "build:main": "npm run build --workspace=@maestri/main",
    "build": "npm run build:shared && npm run build:core && npm run build:preload && npm run build:renderer && npm run build:main",
    "dev:renderer": "npm run dev --workspace=@maestri/renderer",
    "start": "electron packages/main/dist/index.js",
    "setup:graphify": "python -m pip install graphifyy",
    "graphify": "python -m graphify",
    "graphify:build": "python -m graphify .",
    "graphify:open": "node packages/core-daemon/bin/maestri.js graphify open"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^33.2.0",
    "typescript": "^5.7.2"
  }
}
