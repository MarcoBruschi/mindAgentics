{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "mindAgentics",
  "version": "0.26.0",
  "identifier": "com.mindagentics.app",
  "build": {
    "frontendDist": "../packages/renderer/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace=@mindagentics/renderer",
    "beforeBuildCommand": "npm run build --workspace=@mindagentics/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*; frame-src 'self' http: https:; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "title": "mindAgentics",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
